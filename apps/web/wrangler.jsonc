{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Stats Workbench Web ダッシュボード (apps/web) を Cloudflare Workers の
  // Static Assets として配信する設定。
  //
  // - `main` を持たない「静的アセットのみ」の Worker なので、Workers Free プランで
  //   $0 で運用できる(静的アセット配信はリクエスト数課金の対象外)。
  // - ダッシュボードはモックデータで動くため、バックエンドは不要。
  //
  // デプロイ: `pnpm deploy:cf` (= pnpm build && wrangler deploy)
  // 詳細:     docs/deploy-cloudflare.md
  "name": "stats-workbench-dashboard",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // SPA なので未知のパスは index.html にフォールバックさせる
    "not_found_handling": "single-page-application"
  }
}
