{
  "name": "stats-workbench-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.cjs",
    "dev": "vite",
